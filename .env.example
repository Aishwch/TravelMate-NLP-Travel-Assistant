# Optional API Keys for Live Integration (Core application works completely without keys)
# Rename this file to .env to configure optional services

# Optional Weather API (e.g., OpenWeatherMap)
OPENWEATHER_API_KEY=

# Optional Google Maps API (for live transit/maps)
GOOGLE_MAPS_API_KEY=

# Optional Geocoding API
MAPBOX_ACCESS_TOKEN=

# Application Settings
TRAVELMATE_ENV=development
TRAVELMATE_DEBUG=false
